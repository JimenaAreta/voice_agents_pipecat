OPENAI_API_KEY=your-openai-key
DEEPGRAM_API_KEY=your-deepgram-key
ELEVENLABS_API_KEY=your-elevenlabs-key

# Servicios
OPENAI_MODEL=gpt-4.1-nano
OPENAI_LLM_TRANSPORT=http
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es
ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_LANGUAGE=es

# Turnos: smart usa LocalSmartTurnAnalyzerV3; timeout reduce consumo local.
TURN_STOP_STRATEGY=smart
USER_SPEECH_TIMEOUT=0.6
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
VAD_MIN_VOLUME=0.6

# Definir solo después de medir el despliegue con pipecat-ai/stt-benchmark.
# DEEPGRAM_TTFS_P99_LATENCY=0.45

# Base de disponibilidad y reservas confirmadas (contiene datos de contacto).
RESERVATIONS_DB_PATH=data/reservations.sqlite3
